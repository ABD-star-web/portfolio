# Copy this file to .env.local and fill in ONE key (never commit .env.local).
# The "Ask my AI" chat uses DeepSeek if its key is set, otherwise Groq.

# Production (paid, needs credits): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Free for testing, no card: https://console.groq.com/keys
GROQ_API_KEY=
